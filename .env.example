# Copy to .env and fill in. This file is ignored by git.

# The port the phone talks to.
KOKORO_PORT=8880
KOKORO_IMAGE=ghcr.io/technicalheist/kokoro-voice-server:latest

# The model used when a request asks for a rewrite (new_generation).
# Any OpenAI-compatible endpoint works; the key stays on the server.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Chat completions by default. Either shape can be used, and swapping the path
# is enough — no code change:
#   OPENAI_BASE_URL=https://opencode.ai/inference/go
#   OPENAI_PATH=/openai/v1/chat/completions
#   OPENAI_PATH=/openai/v1/responses
OPENAI_PATH=/chat/completions
# Some gateways require a session header; one is generated when this is empty.
OPENAI_SESSION=

# Optional: how the rewrite behaves.
GENERATION_MAX_TOKENS=800
GENERATION_REASONING_EFFORT=low
GENERATION_MAX_CHARS=160
GENERATION_TEMPERATURE=0.7
GENERATION_TIMEOUT=60
# GENERATION_SYSTEM_PROMPT=Answer in one short spoken sentence, same language as the user.
