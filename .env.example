# Copy to .env and fill in. This file is ignored by git.

# The port the phone talks to.
KOKORO_PORT=8880
KOKORO_IMAGE=ghcr.io/technicalheist/kokoro-voice-server:latest

# The model used when a request asks for a rewrite (new_generation).
# Any OpenAI-compatible endpoint works; the key stays on the server.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: how the rewrite behaves.
GENERATION_MAX_TOKENS=220
GENERATION_TEMPERATURE=0.7
GENERATION_TIMEOUT=60
# GENERATION_SYSTEM_PROMPT=Answer in one or two short spoken sentences, same language as the user.
